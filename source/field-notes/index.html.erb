---
title: Field Notes — Arvin Dang
description: Short essays, charts, and experiments by Arvin Dang.
---
<% notes = sitemap.resources.select { |r|
  r.url.start_with?('/field-notes/') && r.url != '/field-notes/' && r.data.title
}.sort_by { |r| r.data.date.to_s }.reverse %>

<main class="field-notes">
  <header class="field-notes__masthead">
    <div class="field-notes__kicker">Field Notes · Est. 2026</div>
    <h1 class="field-notes__title">Field <em>Notes</em></h1>
    <p class="field-notes__lede">
      Short essays, charts, and experiments. Things I made because I wanted to see them.
    </p>
  </header>

  <% if notes.empty? %>
    <p class="field-notes__empty">No notes yet — the press is warming up.</p>
  <% else %>
    <ol class="field-notes__list">
      <% notes.each_with_index do |note, i| %>
        <li class="field-notes__entry">
          <div class="field-notes__meta">
            <span class="field-notes__number">№ <%= format('%03d', notes.length - i) %></span>
            <% if note.data.date %>
              <span class="field-notes__date"><%= Date.parse(note.data.date.to_s).strftime('%b %d, %Y') %></span>
            <% end %>
          </div>
          <div class="field-notes__content">
            <a href="<%= note.url %>" class="field-notes__link">
              <h2 class="field-notes__heading"><%= note.data.title %></h2>
              <% if note.data.description %>
                <p class="field-notes__desc"><%= note.data.description %></p>
              <% end %>
              <span class="field-notes__arrow">Read →</span>
            </a>
          </div>
        </li>
      <% end %>
    </ol>
  <% end %>
</main>
