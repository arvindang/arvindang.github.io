<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= current_page.data.title %> — Arvin Dang</title>
    <meta name="description" content="<%= current_page.data.description %>">
    <meta name="author" content="Arvin Dang">

    <meta property="og:type" content="article">
    <meta property="og:title" content="<%= current_page.data.title %>">
    <meta property="og:description" content="<%= current_page.data.description %>">
    <meta property="og:site_name" content="Arvin Dang — Field Notes">
    <% if current_page.data.date %>
      <meta property="article:published_time" content="<%= current_page.data.date %>">
    <% end %>

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= current_page.data.title %>">
    <meta name="twitter:description" content="<%= current_page.data.description %>">
    <meta name="twitter:creator" content="@arvindang">

    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><circle cx='50' cy='50' r='40' fill='%23C9835A'/></svg>">

    <%= yield_content :head %>
  </head>
  <body>
    <%= yield %>

    <script data-goatcounter="https://arvindang.goatcounter.com/count"
            async src="//gc.zgo.at/count.js"></script>
  </body>
</html>
